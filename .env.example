# ============================================================
# videocomfy - variables de entorno (copiar a .env)
# ------------------------------------------------------------
# La app NO trae ningún dato de la PC de Julián: la config de dónde
# está el ComfyUI vive acá. Por defecto usa el ComfyUI de ESTA máquina
# (127.0.0.1:8188), así que si bajás el repo y lo corrés en tu compu,
# genera con TU ComfyUI (si no lo tenés prendido, no hay generación).
# ============================================================

# Donde vive ComfyUI: 127.0.0.1 = esta máquina (lo normal si clonaste el repo)
COMFYUI_ADDRESS=127.0.0.1

# Puerto de la app (el editor local). El agente de jpiassets espera 5634.
PORT=5634

# Opcional: si además querés usar ComfyUI de otra máquina de tu red
# COMFYUI_ADDRESS=192.168.0.50

# Ollama (lo usa el generador de prompts del storyboard)
OLLAMA_BASE_URL=http://localhost:11434

# --- Solo para el puente con la web (NO hace falta para uso local) --------
# Si en vez de usarla local querés que la web de jpiassets use TU PC, hay
# que correr el agente (../jpiassets/agent) con estos datos, que te da
# quien administra el VPS. Sin esto la app funciona igual, solo local.
# AGENT_URL=
# AGENT_TOKEN=

# --- red COMFYLATAM (el nodo va DENTRO de la app: no hace falta ningun .bat) ---
# Al abrir la app se conecta sola al hub. Estos valores son opcionales:
# vienen por defecto apuntando al hub publico.
RED_HUB=https://vps-4455523-x.dattaweb.com
RED_BASE=/comfylatam
AGENT_TOKEN=comfylatam-nodo-2026
# Tu nodo puede ser el principal (el que sirve el editor historico)
RED_PRINCIPAL=false
